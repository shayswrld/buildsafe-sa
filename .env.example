# ==============================================================================
# Neon Serverless PostgreSQL Configuration
# ==============================================================================
# 1. DATABASE_URL: Neon Pooled Connection String (Host contains '-pooler')
#    Used by Next.js Server Components and API routes in Vercel Serverless Functions.
#    Example: postgresql://user:pass@ep-name-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildsafe?schema=public"

# 2. DIRECT_URL: Neon Direct Connection String (Host without '-pooler')
#    Used by Prisma CLI for running schema pushes and migrations (bypassing pooler).
#    Example: postgresql://user:pass@ep-name.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/buildsafe?schema=public"

# ==============================================================================
# Public Application Settings
# ==============================================================================
NEXT_PUBLIC_APP_NAME="BuildSafe SA"

# ==============================================================================
# South African Provider Keys (Optional — uses interactive sandbox simulators if omitted)
# ==============================================================================
HURU_API_KEY=""
TRADESAFE_CLIENT_ID=""
TRADESAFE_CLIENT_SECRET=""
